#!/bin/bash
# DBA-Bench optional environment loader.
# Usage: cp env.sh.example env.sh, edit as needed, then: source env.sh
# Nothing here is required for the mock demo or standard PostgreSQL/TiDB scenarios.

# --- LLM credentials ----------------------------------------------------------
# The framework reads model credentials from config/llm_config.json (gitignored):
#   cp config/llm_config.example.json config/llm_config.json   # then fill in api_key values

# --- Diagnosis matching (docs/guides/evaluation/semantic-diagnosis-matching.guide.md)
# Default is exact matching; switch to semantic matching via:
# export AIOPS_DP_MATCH_MODE='exact|semantic'
# export AIOPS_DP_SEMANTIC_MODEL='Qwen/Qwen3-4B-Instruct-2507'
# export AIOPS_DP_SEMANTIC_CONFIG='config/llm_config.json'

# --- Knowledge-base embedding (only needed for knowledge-base features) -------
export AIOPS_PG_KB_EMBED_TARGET_DEVICES='cuda:0'
# export AIOPS_PG_KB_EMBED_MODEL='BAAI/bge-m3'
# export AIOPS_PG_KB_EMBED_DEVICE='cuda:0'
